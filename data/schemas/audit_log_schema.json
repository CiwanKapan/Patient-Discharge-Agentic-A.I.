        "message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pipeline message this event came from, if any.",
          "title": "Message Id"
        },
        "audit_id": {
          "const": "AU-07",
          "default": "AU-07",
          "title": "Audit Id",
          "type": "string"
        },
        "event_type": {
          "const": "output_emitted",
          "default": "output_emitted",
          "title": "Event Type",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/OutputEmittedDetails"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "sequence",
        "details"
      ],
      "title": "OutputEmitted",
      "type": "object"
    },
    "OutputEmittedDetails": {
      "additionalProperties": false,
      "properties": {
        "plan": {
          "$ref": "#/$defs/DischargePlan"
        }
      },
      "required": [
        "plan"
      ],
      "title": "OutputEmittedDetails",
      "type": "object"
    },
    "PlannedAction": {
      "additionalProperties": false,
      "properties": {
        "recommendation": {
          "$ref": "#/$defs/Recommendation"
        },
        "approval": {
          "$ref": "#/$defs/ApprovalClassification"
        }
      },
      "required": [
        "recommendation",
        "approval"
      ],
      "title": "PlannedAction",
      "type": "object"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "decision": {
          "enum": [
            "allowed",
            "denied"
          ],
          "title": "Decision",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "pattern": "^G[AF]-T\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Matching GA-T*/GF-T* entry, or null for a tool on neither list.",
          "title": "Rule Id"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "tool_name",
        "decision",
        "reason"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "PolicyDecisionDetails": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "decision": {
          "enum": [
            "allowed",
            "denied"
          ],
          "title": "Decision",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "tool_name",
        "decision",
        "reason"
      ],
      "title": "PolicyDecisionDetails",
      "type": "object"
    },
    "PolicyDecisionEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "sequence": {
          "description": "0 for the first event in a run, then +1 per event.",
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pipeline message this event came from, if any.",
          "title": "Message Id"
        },
        "audit_id": {
          "const": "AU-06",
          "default": "AU-06",
          "title": "Audit Id",
          "type": "string"
        },
        "event_type": {
          "const": "policy_decision",
          "default": "policy_decision",
          "title": "Event Type",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/PolicyDecisionDetails"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "sequence",
        "details"
      ],
      "title": "PolicyDecisionEvent",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "recommendation_id": {
          "title": "Recommendation Id",
          "type": "string"
        },
        "rank": {
          "description": "1 is the most urgent. Equally urgent recommendations share a rank (dense ranking: 1, 1, 2 is valid; 1, 1, 3 is not).",
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "kind": {
          "description": "complete_task resolves a flagged barrier; verify_information asks a human to confirm an information gap.",
          "enum": [
            "complete_task",
            "verify_information"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "urgency": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Urgency",
          "type": "string"
        },
        "owner_role": {
          "enum": [
            "case_manager",
            "nurse",
            "pharmacist",
            "physical_therapist",
            "physician",
            "social_worker"
          ],
          "title": "Owner Role",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^T-(MD|RN|PH|CM)\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "barrier_ids": {
          "items": {
            "type": "string"
          },
          "title": "Barrier Ids",
          "type": "array"
        },
        "information_gap_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Information Gap Field"
        },
        "proposed_action": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Action name the agent wants taken, e.g. 'escalate_to_attending_physician'. Matched against the taxonomy by the approval gate.",
          "title": "Proposed Action"
        },
        "proposed_tool_calls": {
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Proposed Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "recommendation_id",
        "rank",
        "kind",
        "description",
        "urgency",
        "owner_role"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "RunCompleted": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "sequence": {
          "description": "0 for the first event in a run, then +1 per event.",
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string"
            },

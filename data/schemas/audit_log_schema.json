              "type": "null"
            }
          ],
          "default": null,
          "description": "Pipeline message this event came from, if any.",
          "title": "Message Id"
        },
        "audit_id": {
          "const": "AU-08",
          "default": "AU-08",
          "title": "Audit Id",
          "type": "string"
        },
        "event_type": {
          "const": "run_completed",
          "default": "run_completed",
          "title": "Event Type",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/RunCompletedDetails"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "sequence",
        "details"
      ],

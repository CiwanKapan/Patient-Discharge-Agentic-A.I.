{
  "$defs": {
    "ApprovalClassification": {
      "additionalProperties": false,
      "properties": {
        "recommendation_id": {
          "title": "Recommendation Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "auto_safe",
            "requires_human_approval",
            "forbidden"
          ],
          "title": "Classification",
          "type": "string"
        },
        "requires_human_approval": {
          "title": "Requires Human Approval",
          "type": "boolean"
        },
        "matched_rule_id": {
          "anyOf": [
            {
              "pattern": "^(GR-A|GF-T|GA-T)\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GR-A* for approval-required actions, GF-T* for forbidden tools.",
          "title": "Matched Rule Id"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "recommendation_id",
        "classification",
        "requires_human_approval",
        "reason"
      ],
      "title": "ApprovalClassification",
      "type": "object"
    },
    "ApprovalClassificationDetails": {
      "additionalProperties": false,
      "properties": {
        "recommendation_id": {
          "title": "Recommendation Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "auto_safe",
            "requires_human_approval",
            "forbidden"
          ],
          "title": "Classification",
          "type": "string"
        },
        "requires_human_approval": {
          "title": "Requires Human Approval",
          "type": "boolean"
        },
        "matched_rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Rule Id"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "recommendation_id",
        "classification",
        "requires_human_approval",
        "reason"
      ],
      "title": "ApprovalClassificationDetails",
      "type": "object"
    },
    "ApprovalClassified": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "sequence": {
          "description": "0 for the first event in a run, then +1 per event.",
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pipeline message this event came from, if any.",
          "title": "Message Id"
        },
        "audit_id": {
          "const": "AU-05",
          "default": "AU-05",
          "title": "Audit Id",
          "type": "string"
        },
        "event_type": {
          "const": "approval_classification",
          "default": "approval_classification",
          "title": "Event Type",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/ApprovalClassificationDetails"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "sequence",
        "details"
      ],
      "title": "ApprovalClassified",
      "type": "object"
    },
    "BarrierFinding": {
      "additionalProperties": false,
      "properties": {
        "barrier_id": {
          "pattern": "^B-[CEFS]\\d{2}$",
          "title": "Barrier Id",
          "type": "string"
        },
        "urgency": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Urgency",
          "type": "string"
        },
        "cross_field": {
          "description": "True when the barrier only exists because of how two or more facts relate (e.g. transport window vs discharge window).",
          "title": "Cross Field",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "barrier_id",
        "urgency",
        "cross_field",
        "evidence",
        "rationale"
      ],
      "title": "BarrierFinding",
      "type": "object"
    },
    "BarrierFlagged": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "sequence": {
          "description": "0 for the first event in a run, then +1 per event.",
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pipeline message this event came from, if any.",
          "title": "Message Id"
        },
        "audit_id": {
          "const": "AU-03",
          "default": "AU-03",
          "title": "Audit Id",
          "type": "string"
        },
        "event_type": {
          "const": "barrier_flagged",
          "default": "barrier_flagged",
          "title": "Event Type",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/BarrierFlaggedDetails"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "sequence",
        "details"
      ],
      "title": "BarrierFlagged",
      "type": "object"
    },
    "BarrierFlaggedDetails": {
      "additionalProperties": false,
      "properties": {
        "barrier_id": {
          "pattern": "^B-[CEFS]\\d{2}$",
          "title": "Barrier Id",
          "type": "string"
        },
        "evidence_fields": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Fields",
          "type": "array"
        },
        "urgency": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Urgency",
          "type": "string"
        }
      },
      "required": [
        "barrier_id",
        "evidence_fields",
        "urgency"
      ],
      "title": "BarrierFlaggedDetails",
      "type": "object"
    },
    "CaseLoaded": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "sequence": {
          "description": "0 for the first event in a run, then +1 per event.",
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pipeline message this event came from, if any.",
          "title": "Message Id"
        },
        "audit_id": {
          "const": "AU-01",
          "default": "AU-01",
          "title": "Audit Id",
          "type": "string"
        },
        "event_type": {
          "const": "case_loaded",
          "default": "case_loaded",
          "title": "Event Type",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/CaseLoadedDetails"
        }
      },
      "required": [
        "run_id",
        "case_id",
        "sequence",
        "details"
      ],
      "title": "CaseLoaded",
      "type": "object"
    },
    "CaseLoadedDetails": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "description": "Path or identifier the case was read from.",
          "title": "Source",
          "type": "string"
        },
        "case_sha256": {
          "description": "Hash of the raw case file.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Case Sha256",
          "type": "string"
        },
        "schema_valid": {
          "title": "Schema Valid",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "case_sha256",
        "schema_valid"
      ],
      "title": "CaseLoadedDetails",
      "type": "object"
    },
    "DischargePlan": {
      "additionalProperties": false,
      "description": "The structured plan a run returns (logged as AU-07).",
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "barriers": {
          "items": {
            "$ref": "#/$defs/BarrierFinding"
          },
          "title": "Barriers",
          "type": "array"
        },
        "information_gaps": {
          "items": {
            "$ref": "#/$defs/InformationGap"
          },
          "title": "Information Gaps",
          "type": "array"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskFinding"
          },
          "title": "Tasks",
          "type": "array"
        },
        "actions": {
          "description": "In rank order.",
          "items": {
            "$ref": "#/$defs/PlannedAction"
          },
          "title": "Actions",
          "type": "array"
        },
        "denied_tool_calls": {
          "items": {
            "$ref": "#/$defs/PolicyDecision"
          },
          "title": "Denied Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "summary"
      ],
      "title": "DischargePlan",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A pointer into the case that supports a finding.\n\n``field`` is a dotted path into PatientCase, e.g.\n``tracked_fields.transport_status``, ``planned_discharge_window`` or\n``free_text_notes.case_manager_note``.",
      "properties": {
        "field": {
          "pattern": "^(tracked_fields\\.[a-z_]+|planned_discharge_window|free_text_notes\\.[a-z_]+)$",
          "title": "Field",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verbatim chart text or value relied on.",
          "title": "Quote"
        }
      },
      "required": [
        "field"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FieldStatus": {
      "enum": [
        "complete",
        "in_progress",
        "not_started",
        "not_applicable",
        "unknown"
      ],
      "title": "FieldStatus",
      "type": "string"
    },
    "InformationGap": {
      "additionalProperties": false,
      "description": "Information needed to rule a barrier in or out is not documented.\n\nThis is NOT a barrier. It is scored separately and turns into a\nverification action rather than a discharge-blocking finding.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "candidate_barrier_id": {
          "pattern": "^B-[CEFS]\\d{2}$",
          "title": "Candidate Barrier Id",
          "type": "string"
        },
        "question": {
          "description": "What a human should confirm, e.g. 'Is a follow-up booked?'",
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "field",
        "candidate_barrier_id",
        "question"
      ],
      "title": "InformationGap",
      "type": "object"
    },
    "OutputEmitted": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "sequence": {
          "description": "0 for the first event in a run, then +1 per event.",
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"

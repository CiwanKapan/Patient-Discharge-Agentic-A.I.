{
  "$defs": {
    "SignoffItem": {
      "additionalProperties": false,
      "description": "One action the approval gate marked requires_human_approval, awaiting a clinician.",
      "properties": {
        "recommendation_id": {
          "title": "Recommendation Id",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "matched_rule_id": {
          "description": "The approval rule the clinician signs off.",
          "pattern": "^GR-A\\d{2}$",
          "title": "Matched Rule Id",
          "type": "string"
        }
      },
      "required": [
        "recommendation_id",
        "matched_rule_id"
      ],
      "title": "SignoffItem",
      "type": "object"
    },
    "SignoffRequest": {
      "additionalProperties": false,
      "description": "Logged as AU-09 (signoff_requested) when the plan is emitted. The system never\nrecords a clinician's decision; it only requests one.",
      "properties": {
        "status": {
          "default": "pending_clinician_signoff",
          "enum": [
            "pending_clinician_signoff",
            "final"
          ],
          "title": "Status",
          "type": "string"
        },
        "actions": {
          "description": "Gated actions awaiting sign-off.",
          "items": {
            "$ref": "#/$defs/SignoffItem"
          },
          "title": "Actions",
          "type": "array"
        }
      },
      "title": "SignoffRequest",
      "type": "object"
    },
    "Stage": {
      "enum": [
        "01_input_reader",
        "02_case_analyzer",
        "03_barrier_detector",
        "04_task_detector",
        "05_rec_generator",
        "06_approval_gate",
        "07_policy_layer",
        "08_output_composer",
        "09_signoff_request"
      ],
      "title": "Stage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model id for LLM stages, null for deterministic code.",
      "title": "Model"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "upstream": {
      "description": "message_ids this message was built from.",
      "items": {
        "type": "string"
      },
      "title": "Upstream",
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/SignoffRequest"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "stage",
    "payload"
  ],
  "title": "AgentMessage[SignoffRequest]",
  "type": "object"
}

{
  "$defs": {
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "recommendation_id": {
          "title": "Recommendation Id",
          "type": "string"
        },
        "rank": {
          "description": "1 is the most urgent. Equally urgent recommendations share a rank (dense ranking: 1, 1, 2 is valid; 1, 1, 3 is not).",
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "kind": {
          "description": "complete_task resolves a flagged barrier; verify_information asks a human to confirm an information gap.",
          "enum": [
            "complete_task",
            "verify_information"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "urgency": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Urgency",
          "type": "string"
        },
        "owner_role": {
          "enum": [
            "case_manager",
            "nurse",
            "pharmacist",
            "physical_therapist",
            "physician",
            "social_worker"
          ],
          "title": "Owner Role",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "pattern": "^T-(MD|RN|PH|CM)\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "barrier_ids": {
          "items": {
            "type": "string"
          },
          "title": "Barrier Ids",
          "type": "array"
        },
        "information_gap_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Information Gap Field"
        },
        "proposed_action": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Action name the agent wants taken, e.g. 'escalate_to_attending_physician'. Matched against the taxonomy by the approval gate.",
          "title": "Proposed Action"
        },
        "proposed_tool_calls": {
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "title": "Proposed Tool Calls",
          "type": "array"
        }
      },
      "required": [
        "recommendation_id",
        "rank",
        "kind",
        "description",
        "urgency",
        "owner_role"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "RecommendationSet": {
      "additionalProperties": false,
      "properties": {
        "recommendations": {
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Recommendations",
          "type": "array"
        }
      },
      "title": "RecommendationSet",
      "type": "object"
    },
    "Stage": {
      "enum": [
        "01_input_reader",
        "02_case_analyzer",
        "03_barrier_detector",
        "04_task_detector",
        "05_rec_generator",
        "06_approval_gate",
        "07_policy_layer",
        "08_output_composer"
      ],
      "title": "Stage",
      "type": "string"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "A request to run a tool. Proposed by an LLM stage, never run before policy review.",
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "tool_name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Tool Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "requested_by": {
          "$ref": "#/$defs/Stage"
        }
      },
      "required": [
        "tool_name",
        "requested_by"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model id for LLM stages, null for deterministic code.",
      "title": "Model"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "upstream": {
      "description": "message_ids this message was built from.",
      "items": {
        "type": "string"
      },
      "title": "Upstream",
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/RecommendationSet"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "stage",
    "payload"
  ],
  "title": "AgentMessage[RecommendationSet]",
  "type": "object"
}

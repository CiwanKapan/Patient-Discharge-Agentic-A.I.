{
  "$defs": {
    "ApprovalClassification": {
      "additionalProperties": false,
      "properties": {
        "recommendation_id": {
          "title": "Recommendation Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "auto_safe",
            "requires_human_approval",
            "forbidden"
          ],
          "title": "Classification",
          "type": "string"
        },
        "requires_human_approval": {
          "title": "Requires Human Approval",
          "type": "boolean"
        },
        "matched_rule_id": {
          "anyOf": [
            {
              "pattern": "^(GR-A|GF-T|GA-T)\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GR-A* for approval-required actions, GF-T* for forbidden tools.",
          "title": "Matched Rule Id"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "label_missing": {
          "default": false,
          "description": "True when approval comes from the task (governance.task_approvals) because the recommendation named no approval-required action. Records the model's omission.",
          "title": "Label Missing",
          "type": "boolean"
        }
      },
      "required": [
        "recommendation_id",
        "classification",
        "requires_human_approval",
        "reason"
      ],
      "title": "ApprovalClassification",
      "type": "object"
    },
    "ApprovalDecisions": {
      "additionalProperties": false,
      "properties": {
        "classifications": {
          "items": {
            "$ref": "#/$defs/ApprovalClassification"
          },
          "title": "Classifications",
          "type": "array"
        }
      },
      "title": "ApprovalDecisions",
      "type": "object"
    },
    "Stage": {
      "enum": [
        "01_input_reader",
        "02_case_analyzer",
        "03_barrier_detector",
        "04_task_detector",
        "05_rec_generator",
        "06_approval_gate",
        "07_policy_layer",
        "08_output_composer",
        "09_signoff_request"
      ],
      "title": "Stage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model id for LLM stages, null for deterministic code.",
      "title": "Model"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "upstream": {
      "description": "message_ids this message was built from.",
      "items": {
        "type": "string"
      },
      "title": "Upstream",
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/ApprovalDecisions"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "stage",
    "payload"
  ],
  "title": "AgentMessage[ApprovalDecisions]",
  "type": "object"
}

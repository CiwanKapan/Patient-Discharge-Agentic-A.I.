{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A pointer into the case that supports a finding.\n\n``field`` is a dotted path into PatientCase, e.g.\n``tracked_fields.transport_status``, ``planned_discharge_window`` or\n``free_text_notes.case_manager_note``.",
      "properties": {
        "field": {
          "pattern": "^(tracked_fields\\.[a-z_]+|planned_discharge_window|free_text_notes\\.[a-z_]+)$",
          "title": "Field",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verbatim chart text or value relied on.",
          "title": "Quote"
        }
      },
      "required": [
        "field"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FieldStatus": {
      "enum": [
        "complete",
        "in_progress",
        "not_started",
        "not_applicable",
        "unknown"
      ],
      "title": "FieldStatus",
      "type": "string"
    },
    "Stage": {
      "enum": [
        "01_input_reader",
        "02_case_analyzer",
        "03_barrier_detector",
        "04_task_detector",
        "05_rec_generator",
        "06_approval_gate",
        "07_policy_layer",
        "08_output_composer",
        "09_signoff_request"
      ],
      "title": "Stage",
      "type": "string"
    },
    "TaskDetection": {
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskFinding"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "title": "TaskDetection",
      "type": "object"
    },
    "TaskFinding": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "pattern": "^T-(MD|RN|PH|CM)\\d{2}$",
          "title": "Task Id",
          "type": "string"
        },
        "resolves": {
          "description": "Barrier IDs this task resolves.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Resolves",
          "type": "array"
        },
        "owner_role": {
          "enum": [
            "case_manager",
            "nurse",
            "pharmacist",
            "physical_therapist",
            "physician",
            "social_worker"
          ],
          "title": "Owner Role",
          "type": "string"
        },
        "urgency": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Urgency",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "resolves",
        "owner_role",
        "urgency",
        "evidence",
        "rationale"
      ],
      "title": "TaskFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/Stage"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model id for LLM stages, null for deterministic code.",
      "title": "Model"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "upstream": {
      "description": "message_ids this message was built from.",
      "items": {
        "type": "string"
      },
      "title": "Upstream",
      "type": "array"
    },
    "payload": {
      "$ref": "#/$defs/TaskDetection"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "case_id",
    "stage",
    "payload"
  ],
  "title": "AgentMessage[TaskDetection]",
  "type": "object"
}
